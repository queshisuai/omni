    },
    {
      "para_index": 7,
      "text": "\uff08\u586b\u5199\u5f00\u9898\u5f53\u65f6\u7684\u9898\u76ee\uff0c\u8868\u5934\u586b\u5199\u5185\u5bb9\u7528\u5c0f4\u53f7\u5b57\u4f53\uff09",
      "style": "\u6837\u5f0f1"
    },
    {
      "para_index": 24,
      "text": "\u4e00\u3001\u9009\u9898\u7684\u4f9d\u636e\uff08\u9009\u9898\u6765\u6e90\uff09\u53ca\u610f\u4e49\uff08\u4e00\u7ea7\u6807\u98984\u53f7\u5b8b\u4f53\uff0c\u52a0\u7c97\uff0c\u9876\u683c\uff0c1.5\u500d\u884c\u8ddd\uff09",
      "style": "\u6837\u5f0f1"
