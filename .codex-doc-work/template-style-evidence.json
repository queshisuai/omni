      "para_index": 1,
      "text": "\u5e7f\u5dde\u5de5\u5546\u5b66\u9662\u672c\u79d1\u6bd5\u4e1a\u8bba\u6587\uff08\u8bbe\u8ba1\uff09\u5f00\u9898\u62a5\u544a",
      "style": "Normal"
    },
    {
      "para_index": 3,
      "text": "\u6ce8\uff1a\u5404\u4e8c\u7ea7\u5b66\u9662\u8981\u7ec4\u7ec7\u5404\u4e13\u4e1a\u6559\u7814\u5ba4\u5bf9\u5b66\u751f\u5f00\u9898\u62a5\u544a\u8fdb\u884c\u5ba1\u6838\uff0c\u5ba1\u6838\u5408\u683c\u540e\u65b9\u53ef\u6b63\u5f0f\u8fdb\u5165\u4e0b\u4e00\u6bd5\u4e1a\u8bba\u6587\uff08\u8bbe\u8ba1\uff09\u9636\u6bb5\u3002",
      "style": "Normal"
    },
    {
      "para_index": 5,
      "text": "\uff08\u586b\u5199\u5f00\u9898\u5f53\u65f6\u7684\u9898\u76ee\uff0c\u8868\u5934\u586b\u5199\u5185\u5bb9\u7528\u5c0f4\u53f7\u5b57\u4f53\uff09",
      "style": "\u6837\u5f0f1"
    },
    {
      "para_index": 6,
      "text": "\uff08\u586b\u5199\u5f00\u9898\u5f53\u65f6\u7684\u9898\u76ee\uff0c\u8868\u5934\u586b\u5199\u5185\u5bb9\u7528\u5c0f4\u53f7\u5b57\u4f53\uff09",
