    {
      "para_index": 35,
      "text": "\uff08\u4e8c\uff09\u7814\u7a76\u5185\u5bb9",
      "style": "\u6837\u5f0f1"
    },
    {
      "para_index": 37,
      "text": "\u56db\u3001\u7814\u7a76\u65b9\u6cd5",
      "style": "\u6837\u5f0f1"
    },
    {
      "para_index": 38,
      "text": "1. \u6587\u732e\u7814\u7a76\u6cd5\uff1a\uff08\u9610\u8ff0\u7814\u7a76\u65b9\u6cd5\u7684\u65f6\u5019\u4e0d\u80fd\u53ea\u7f57\u5217\u6982\u5ff5\uff0c\u8981\u7b80\u5355\u8bf4\u660e\u6b64\u65b9\u6cd5\u5728\u8bba\u6587\u4e2d\u7684\u5e94\u7528\uff09",
      "style": "\u6837\u5f0f1"
    },
    {
      "para_index": 41,
      "text": "\u5176\u4ed6\u8bf4\u660e\uff1a\u82e5\u8bfe\u9898\u6d89\u53ca\u65b9\u6848\u8bbe\u8ba1\uff0c\u8fd8\u9700\u8981\u6709\u65b9\u6848\u7684\u53ef\u884c\u6027\u5206\u6790\u548c\u5df2\u5177\u5907\u7684\u6761\u4ef6\u5206\u6790",
      "style": "\u6837\u5f0f1"
    },
    {
      "para_index": 42,
      "text": "\u4e94\u3001\u8fdb\u5ea6\u5b89\u6392\uff08\u8fdb\u5ea6\u5b89\u6392\u8981\u5199\u8d77\u6b62\u65e5\u671f\uff0c\u8981\u4e0e\u4efb\u52a1\u4e66\u4e00\u81f4\uff0c\u8d2f\u7a7f\u8bba\u6587\u59cb\u7ec8\uff0c\u5230\u7ec8\u7a3f\u4fee\u6539\uff09",
      "style": "\u6837\u5f0f1"
    },
    {
      "para_index": 45,
      "text": "\u516d\u3001\u4e3b\u8981\u53c2\u8003\u6587\u732e",
