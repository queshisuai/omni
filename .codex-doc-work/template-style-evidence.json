    {
      "para_index": 26,
      "text": "\u4e8c\u3001\u56fd\u5185\u5916\u7814\u7a76\u7efc\u8ff0",
      "style": "\u6837\u5f0f1"
    },
    {
      "para_index": 27,
      "text": "\uff08\u4e00\uff09\u56fd\u5916\u7814\u7a76\u7efc\u8ff0\uff08\u4e8c\u7ea7\u6807\u9898\u5c0f4\u53f7\u5b8b\u4f53\uff0c\u52a0\u7c97\uff0c\u6bb5\u524d\u7a7a\u4e24\u683c\uff0c1.5\u500d\u884c\u8ddd\uff09",
      "style": "\u6837\u5f0f1"
    },
    {
      "para_index": 29,
      "text": "\uff08\u6bb5\u843d\u683c\u5f0f\uff1a\u6bb5\u524d\u7a7a\u4e24\u683c\uff0c\u5c0f4\u53f7\u5b8b\u4f53\uff0c1.5\u500d\u884c\u8ddd\uff09",
