page {
  min-height: 100vh;
  background: #f5f7fb;
  color: #121826;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

view,
text,
button,
input {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  line-height: 1;
  border-radius: 0;
  background: transparent;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding-bottom: 48rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 34rpx 32rpx 18rpx;
}

.section-title text:first-child {
  font-size: 36rpx;
  font-weight: 800;
  color: #121826;
}

.section-title text:last-child {
  font-size: 24rpx;
  color: #657085;
}

.primary-button {
  height: 92rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #2563eb, #7c3aed);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 18rpx 40rpx rgba(37, 99, 235, 0.28);
}

.ghost-button {
  height: 84rpx;
  border: 2rpx solid #dbe3f0;
  border-radius: 24rpx;
  color: #2563eb;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
}

.safe-bottom {
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
}
