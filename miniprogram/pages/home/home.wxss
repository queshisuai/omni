.home-page {
  padding-bottom: 40rpx;
}

.hero {
  position: relative;
  padding: 34rpx 32rpx 42rpx;
  border-bottom-left-radius: 42rpx;
  border-bottom-right-radius: 42rpx;
  overflow: hidden;
  color: #ffffff;
}

.loading-hero {
  min-height: 360rpx;
  background: linear-gradient(145deg, #07111f, #1d4ed8 58%, #7c3aed);
}

.hero-glow {
  position: absolute;
  top: -110rpx;
  right: -90rpx;
  width: 330rpx;
  height: 330rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
}

.hero-top {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.eyebrow {
  display: block;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.hero-title {
  display: block;
  margin-top: 10rpx;
  font-size: 52rpx;
  font-weight: 900;
}

.city-pill {
  min-width: 96rpx;
  height: 52rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.search-box {
  position: relative;
  margin-top: 34rpx;
  height: 82rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.16);
  color: rgba(255, 255, 255, 0.82);
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  font-size: 26rpx;
}

.error-card {
  position: relative;
  margin-top: 34rpx;
  padding: 26rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.16);
}

.error-card text {
  display: block;
  color: rgba(255, 255, 255, 0.88);
  font-size: 25rpx;
  line-height: 1.5;
}

.error-card button {
  width: 220rpx;
  height: 64rpx;
  margin-top: 20rpx;
  border-radius: 20rpx;
  background: #ffffff;
  color: #2563eb;
  font-size: 25rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-card {
  position: relative;
  margin-top: 28rpx;
  min-height: 300rpx;
  border-radius: 34rpx;
  overflow: hidden;
  background: rgba(5, 10, 23, 0.32);
  box-shadow: 0 26rpx 70rpx rgba(0, 0, 0, 0.25);
}

.poster-stage {
  position: relative;
  height: 178rpx;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.15), rgba(15, 23, 42, 0.86));
  overflow: hidden;
}

.beam {
  position: absolute;
  top: -24rpx;
  width: 150rpx;
  height: 270rpx;
  background: rgba(147, 197, 253, 0.34);
  transform-origin: top center;
}

.beam-left {
  left: 110rpx;
  transform: rotate(22deg);
}

.beam-right {
  right: 120rpx;
  transform: rotate(-20deg);
}

.crowd {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 52rpx;
  background: repeating-linear-gradient(90deg, rgba(255,255,255,0.2) 0 8rpx, transparent 8rpx 20rpx);
}

.hero-info {
  padding: 24rpx 28rpx 30rpx;
}

.hero-tag {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
  color: #dbeafe;
}

.hero-name {
  display: block;
  margin-top: 14rpx;
  font-size: 34rpx;
  font-weight: 900;
}

.hero-meta {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.tabs {
  white-space: nowrap;
  margin: 26rpx 0 6rpx;
  padding-left: 32rpx;
}

.tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 28rpx;
  margin-right: 18rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #64748b;
  font-size: 26rpx;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.06);
}

.tab-active {
  color: #ffffff;
  background: #2563eb;
}

.event-list {
  padding: 0 32rpx;
}

.empty-state {
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
  font-size: 26rpx;
}

.event-card {
  display: flex;
  gap: 24rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 46rpx rgba(15, 23, 42, 0.08);
}

.event-poster {
  position: relative;
  flex: 0 0 176rpx;
  height: 214rpx;
  border-radius: 24rpx;
  overflow: hidden;
  color: #ffffff;
}

.stage-line {
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  bottom: 42rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 0 28rpx rgba(255, 255, 255, 0.65);
}

.event-poster text {
  position: absolute;
  left: 20rpx;
  bottom: 66rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.event-body {
  flex: 1;
  min-width: 0;
}

.event-title-row {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
}

.event-title {
  flex: 1;
  font-size: 31rpx;
  line-height: 1.25;
  font-weight: 900;
  color: #111827;
}

.event-tag {
  flex: 0 0 auto;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 20rpx;
  font-weight: 700;
}

.event-artist,
.event-meta {
  display: block;
  margin-top: 14rpx;
  color: #64748b;
  font-size: 24rpx;
}

.event-meta {
  line-height: 1.35;
}

.event-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
}

.event-price {
  color: #ef4444;
  font-size: 30rpx;
  font-weight: 900;
}

.detail-link {
  min-width: 90rpx;
  height: 52rpx;
  border-radius: 18rpx;
  background: #f1f5f9;
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
