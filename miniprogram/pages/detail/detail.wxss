.detail-page {
  padding-bottom: 170rpx;
}

.detail-state {
  min-height: 720rpx;
  padding: 80rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #64748b;
  font-size: 28rpx;
}

.detail-state .ghost-button {
  width: 300rpx;
  margin-top: 30rpx;
}

.detail-hero {
  position: relative;
  height: 500rpx;
  padding: 40rpx 32rpx;
  overflow: hidden;
}

.light {
  position: absolute;
  top: -80rpx;
  width: 190rpx;
  height: 520rpx;
  background: rgba(255, 255, 255, 0.2);
  transform-origin: top center;
}

.light-a {
  left: 150rpx;
  transform: rotate(20deg);
}

.light-b {
  right: 140rpx;
  transform: rotate(-18deg);
}

.detail-poster {
  position: absolute;
  left: 64rpx;
  right: 64rpx;
  bottom: 60rpx;
  height: 280rpx;
  border-radius: 36rpx;
  background: rgba(2, 6, 23, 0.45);
  box-shadow: 0 36rpx 90rpx rgba(0, 0, 0, 0.32);
  overflow: hidden;
}

.detail-poster text {
  position: absolute;
  left: 32rpx;
  bottom: 38rpx;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 900;
}

.poster-stage-line {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 96rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 0 40rpx rgba(255, 255, 255, 0.8);
}

.detail-card {
  position: relative;
  z-index: 2;
  margin: -34rpx 32rpx 0;
  padding: 30rpx;
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 54rpx rgba(15, 23, 42, 0.1);
}

.title-row {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.event-title {
  display: block;
  font-size: 40rpx;
  line-height: 1.22;
  color: #111827;
  font-weight: 900;
}

.event-summary {
  display: block;
  margin-top: 16rpx;
  color: #64748b;
  font-size: 25rpx;
  line-height: 1.55;
}

.tag {
  flex: 0 0 auto;
  padding: 9rpx 18rpx;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 800;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 28rpx;
}

.info-item {
  flex: 1 1 220rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  background: #f8fafc;
}

.info-item.wide {
  flex-basis: 100%;
}

.info-label {
  display: block;
  color: #94a3b8;
  font-size: 22rpx;
}

.info-value {
  display: block;
  margin-top: 8rpx;
  color: #111827;
  font-size: 26rpx;
  font-weight: 800;
}

.ticket-list {
  padding: 0 32rpx;
}

.ticket-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx;
  margin-bottom: 18rpx;
  border: 2rpx solid transparent;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 44rpx rgba(15, 23, 42, 0.07);
}

.ticket-active {
  border-color: #2563eb;
  background: #eff6ff;
}

.ticket-name {
  display: block;
  font-size: 30rpx;
  color: #111827;
  font-weight: 900;
}

.ticket-area {
  display: block;
  margin-top: 10rpx;
  color: #64748b;
  font-size: 23rpx;
}

.ticket-price {
  color: #ef4444;
  font-size: 34rpx;
  font-weight: 900;
}

.seat-panel {
  margin: 28rpx 32rpx 0;
  padding: 30rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 44rpx rgba(15, 23, 42, 0.07);
}

.screen {
  width: 260rpx;
  height: 44rpx;
  margin: 0 auto 26rpx;
  border-radius: 0 0 999rpx 999rpx;
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
  color: #2563eb;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.seat-row {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-top: 16rpx;
}

.seat-row.short {
  gap: 28rpx;
}

.seat {
  width: 42rpx;
  height: 42rpx;
  border-radius: 14rpx;
  background: #dbe3f0;
}

.seat.active {
  background: #2563eb;
}

.seat.sold {
  background: #cbd5e1;
  opacity: 0.45;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 26rpx;
  padding: 22rpx 32rpx;
  background: #ffffff;
  box-shadow: 0 -16rpx 44rpx rgba(15, 23, 42, 0.08);
}

.bottom-label {
  display: block;
  color: #94a3b8;
  font-size: 22rpx;
}

.bottom-price {
  display: block;
  margin-top: 6rpx;
  color: #ef4444;
  font-size: 34rpx;
  font-weight: 900;
}

.buy-button {
  width: 320rpx;
  height: 86rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #2563eb, #7c3aed);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}
