<view wx:if="{{loading}}" class="page detail-state">
  <text>正在加载活动详情</text>
</view>

<view wx:elif="{{errorMessage}}" class="page detail-state">
  <text>{{errorMessage}}</text>
  <button class="ghost-button" bindtap="useDemoDetail" data-id="concert-blue-night">查看演示活动</button>
</view>

<view wx:elif="{{event}}" class="page detail-page">
  <view class="detail-hero" style="background: {{event.gradient}};">
    <view class="light light-a"></view>
    <view class="light light-b"></view>
    <view class="detail-poster">
      <view class="poster-stage-line"></view>
      <text>{{event.artist}}</text>
    </view>
  </view>

  <view class="detail-card">
    <view class="title-row">
      <view>
        <text class="event-title">{{event.title}}</text>
        <text class="event-summary">{{event.summary}}</text>
      </view>
      <view class="tag">{{event.tag}}</view>
    </view>

    <view class="info-grid">
      <view class="info-item">
        <text class="info-label">时间</text>
        <text class="info-value">{{event.date}} {{event.time}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">城市</text>
        <text class="info-value">{{event.city}}</text>
      </view>
      <view class="info-item wide">
        <text class="info-label">场馆</text>
        <text class="info-value">{{event.venue}}</text>
      </view>
    </view>
  </view>

  <view class="section-title">
    <text>选择票档</text>
    <text>模拟库存</text>
  </view>

  <view class="ticket-list">
    <view
      wx:for="{{event.tickets}}"
      wx:key="id"
      class="ticket-card {{selectedTicketId === item.id ? 'ticket-active' : ''}}"
      bindtap="selectTicket"
      data-id="{{item.id}}"
    >
      <view>
        <text class="ticket-name">{{item.name}}</text>
        <text class="ticket-area">{{item.area}} · 剩余 {{item.stock}} 张</text>
      </view>
      <text class="ticket-price">¥{{item.price}}</text>
    </view>
  </view>

  <view class="seat-panel">
    <view class="screen">舞台</view>
    <view class="seat-row">
      <view class="seat active"></view>
      <view class="seat active"></view>
      <view class="seat"></view>
      <view class="seat"></view>
      <view class="seat sold"></view>
      <view class="seat"></view>
    </view>
    <view class="seat-row short">
      <view class="seat"></view>
      <view class="seat active"></view>
      <view class="seat"></view>
      <view class="seat sold"></view>
    </view>
  </view>

  <view class="bottom-bar safe-bottom">
    <view>
      <text class="bottom-label">最低票价</text>
      <text class="bottom-price">¥{{event.minPrice}}起</text>
    </view>
    <button class="buy-button" bindtap="goOrder">立即购票</button>
  </view>
</view>
