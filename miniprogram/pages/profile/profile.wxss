.profile-page {
  padding: 34rpx 32rpx 48rpx;
}

.profile-hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 34rpx;
  border-radius: 36rpx;
  background: linear-gradient(145deg, #07111f, #1d4ed8 58%, #7c3aed);
  color: #ffffff;
  box-shadow: 0 24rpx 64rpx rgba(37, 99, 235, 0.22);
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 900;
}

.name {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
}

.role {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.stat-grid {
  display: flex;
  gap: 18rpx;
  margin-top: 26rpx;
}

.stat-card {
  flex: 1;
  min-height: 130rpx;
  border-radius: 26rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 42rpx rgba(15, 23, 42, 0.07);
}

.stat-card text:first-child {
  color: #2563eb;
  font-size: 34rpx;
  font-weight: 900;
}

.stat-card text:last-child {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 22rpx;
}

.menu {
  margin: 28rpx 0 36rpx;
  padding: 8rpx 28rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 42rpx rgba(15, 23, 42, 0.07);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  min-height: 92rpx;
  border-bottom: 2rpx solid #f1f5f9;
  font-size: 26rpx;
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-item text:first-child {
  color: #111827;
  font-weight: 800;
}

.menu-item text:last-child {
  max-width: 420rpx;
  color: #64748b;
  text-align: right;
}
