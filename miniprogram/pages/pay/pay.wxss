.pay-page {
  padding: 34rpx 32rpx 48rpx;
}

.pay-state {
  min-height: 720rpx;
  padding: 80rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #64748b;
  font-size: 28rpx;
}

.pay-hero {
  padding: 46rpx 34rpx;
  border-radius: 36rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #07111f, #1d4ed8 58%, #7c3aed);
  box-shadow: 0 24rpx 64rpx rgba(37, 99, 235, 0.22);
}

.pay-label {
  display: block;
  color: rgba(255, 255, 255, 0.72);
  font-size: 26rpx;
}

.pay-amount {
  display: block;
  margin-top: 18rpx;
  font-size: 72rpx;
  font-weight: 900;
}

.pay-tip {
  display: block;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
}

.pay-card,
.method-card {
  margin-top: 26rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 42rpx rgba(15, 23, 42, 0.07);
}

.pay-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 66rpx;
  color: #64748b;
  font-size: 26rpx;
}

.pay-row text:last-child {
  max-width: 440rpx;
  text-align: right;
  color: #111827;
  font-weight: 800;
}

.pending {
  color: #b45309 !important;
}

.method-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.method-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 30rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.method-name,
.method-desc {
  display: block;
}

.method-name {
  color: #111827;
  font-size: 29rpx;
  font-weight: 900;
}

.method-desc {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
}

.mock-button {
  margin-top: 40rpx;
}
