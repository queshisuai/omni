<view wx:if="{{errorMessage}}" class="page pay-state">
  <text>{{errorMessage}}</text>
</view>

<view wx:elif="{{event && ticket}}" class="page pay-page">
  <view class="pay-hero">
    <text class="pay-label">需支付</text>
    <text class="pay-amount">¥{{total}}</text>
    <text class="pay-tip">当前为后端模拟支付，不产生真实扣款</text>
  </view>

  <view class="pay-card">
    <view class="pay-row">
      <text>活动</text>
      <text>{{event.title}}</text>
    </view>
    <view class="pay-row">
      <text>票档</text>
      <text>{{ticket.name}}</text>
    </view>
    <view class="pay-row">
      <text>数量</text>
      <text>{{quantity}} 张</text>
    </view>
    <view class="pay-row">
      <text>订单状态</text>
      <text class="pending">待模拟支付</text>
    </view>
    <view class="pay-row" wx:if="{{order}}">
      <text>订单号</text>
      <text>{{order.orderNo}}</text>
    </view>
  </view>

  <view class="method-card">
    <view class="method-icon">模</view>
    <view>
      <text class="method-name">模拟支付通道</text>
      <text class="method-desc">调用后端模拟支付接口，不调用微信支付</text>
    </view>
  </view>

  <button class="primary-button mock-button" bindtap="mockPay">
    {{paying ? '正在处理' : '确认模拟支付'}}
  </button>
</view>
