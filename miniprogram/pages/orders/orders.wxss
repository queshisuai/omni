.orders-page {
  padding: 32rpx;
}

.orders-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.orders-title {
  display: block;
  color: #111827;
  font-size: 44rpx;
  font-weight: 900;
}

.orders-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
}

.clear-button {
  width: 108rpx;
  height: 56rpx;
  border-radius: 18rpx;
  color: #64748b;
  background: #ffffff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.order-item {
  padding: 28rpx;
  margin-bottom: 24rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 42rpx rgba(15, 23, 42, 0.07);
}

.order-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.order-title {
  flex: 1;
  color: #111827;
  font-size: 31rpx;
  line-height: 1.35;
  font-weight: 900;
}

.status {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #dcfce7;
  color: #16a34a;
  font-size: 22rpx;
  font-weight: 800;
}

.status-1 {
  background: #fff7ed;
  color: #b45309;
}

.status-2 {
  background: #dcfce7;
  color: #16a34a;
}

.status-3,
.status-4 {
  background: #f1f5f9;
  color: #64748b;
}

.order-meta {
  display: block;
  margin-top: 16rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.45;
}

.ticket-line {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid #f1f5f9;
  color: #111827;
  font-size: 27rpx;
  font-weight: 800;
}

.ticket-line text:last-child {
  color: #ef4444;
  font-weight: 900;
}

.order-code {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: repeating-linear-gradient(45deg, #f8fafc 0 16rpx, #eef2ff 16rpx 32rpx);
}

.order-code text {
  display: block;
  color: #475569;
  font-size: 23rpx;
}

.order-code text:last-child {
  margin-top: 6rpx;
  color: #2563eb;
  font-weight: 900;
}

.empty {
  min-height: 720rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.empty-visual {
  width: 210rpx;
  height: 160rpx;
  border-radius: 34rpx;
  background: linear-gradient(145deg, #dbeafe, #bfdbfe);
  box-shadow: inset 0 -34rpx 0 rgba(37, 99, 235, 0.16);
}

.empty-title {
  display: block;
  margin-top: 32rpx;
  color: #111827;
  font-size: 34rpx;
  font-weight: 900;
}

.empty-desc {
  display: block;
  width: 520rpx;
  margin: 16rpx 0 36rpx;
  color: #64748b;
  font-size: 25rpx;
  line-height: 1.55;
}
