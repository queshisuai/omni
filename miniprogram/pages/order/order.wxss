.order-page {
  padding: 28rpx 32rpx 170rpx;
}

.order-state {
  min-height: 720rpx;
  padding: 80rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #64748b;
  font-size: 28rpx;
}

.order-card {
  display: flex;
  gap: 24rpx;
  padding: 22rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 46rpx rgba(15, 23, 42, 0.08);
}

.mini-poster {
  position: relative;
  width: 150rpx;
  height: 176rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.poster-line {
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  bottom: 48rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 0 26rpx rgba(255, 255, 255, 0.7);
}

.order-event {
  flex: 1;
  min-width: 0;
  padding: 8rpx 0;
}

.order-title {
  display: block;
  font-size: 34rpx;
  line-height: 1.3;
  color: #111827;
  font-weight: 900;
}

.order-meta {
  display: block;
  margin-top: 14rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.35;
}

.panel {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 42rpx rgba(15, 23, 42, 0.07);
}

.panel-title {
  margin-bottom: 22rpx;
  color: #111827;
  font-size: 31rpx;
  font-weight: 900;
}

.row,
.quantity-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 64rpx;
  color: #64748b;
  font-size: 26rpx;
}

.row text:last-child,
.quantity-row text:last-child {
  color: #111827;
  font-weight: 800;
}

.price {
  color: #ef4444 !important;
}

.stepper {
  display: flex;
  align-items: center;
  height: 64rpx;
  border-radius: 20rpx;
  background: #f1f5f9;
  overflow: hidden;
}

.stepper button {
  width: 64rpx;
  height: 64rpx;
  color: #2563eb;
  font-size: 34rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stepper text {
  width: 70rpx;
  color: #111827;
  font-size: 28rpx;
  font-weight: 900;
  text-align: center;
}

.buyer {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #2563eb, #7c3aed);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.buyer-name,
.buyer-phone {
  display: block;
}

.buyer-name {
  color: #111827;
  font-size: 28rpx;
  font-weight: 900;
}

.buyer-phone {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
}

.notice {
  margin-top: 24rpx;
  padding: 24rpx 26rpx;
  border-radius: 26rpx;
  background: #fff7ed;
  color: #b45309;
  font-size: 24rpx;
  line-height: 1.5;
}

.summary {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  padding: 22rpx 32rpx;
  background: #ffffff;
  box-shadow: 0 -16rpx 44rpx rgba(15, 23, 42, 0.08);
}

.summary-label {
  display: block;
  color: #94a3b8;
  font-size: 22rpx;
}

.summary-price {
  display: block;
  margin-top: 6rpx;
  color: #ef4444;
  font-size: 38rpx;
  font-weight: 900;
}

.pay-entry {
  width: 330rpx;
}
