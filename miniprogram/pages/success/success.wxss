.success-page {
  padding: 96rpx 32rpx 48rpx;
}

.success-card {
  padding: 58rpx 34rpx;
  margin-bottom: 38rpx;
  border-radius: 38rpx;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 18rpx 54rpx rgba(15, 23, 42, 0.08);
}

.checkmark {
  width: 126rpx;
  height: 126rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: linear-gradient(135deg, #2563eb, #22c55e);
  color: #ffffff;
  font-size: 64rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-title {
  display: block;
  margin-top: 34rpx;
  color: #111827;
  font-size: 42rpx;
  font-weight: 900;
}

.success-desc {
  display: block;
  margin-top: 18rpx;
  color: #64748b;
  font-size: 26rpx;
  line-height: 1.55;
}

.order-id {
  display: block;
  margin-top: 30rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  color: #475569;
  font-size: 23rpx;
  word-break: break-all;
}

.ghost-button {
  margin-top: 22rpx;
}
