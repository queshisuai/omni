# ============================================================
# Omni 万象抢票平台 .gitignore
# ============================================================

# ===================================================
# 1. IDE 和编辑器配置
# ===================================================

# Visual Studio Code
.vscode/

# JetBrains (IntelliJ IDEA / WebStorm / PyCharm)
.idea/
*.iml

# Visual Studio
.vs/
*.suo
*.user

# Eclipse / STS
.classpath
.project
.settings/

# Trae
.trae/

# Vim / Neovim
*.swp
*.swo
*~

# Emacs
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace


# ===================================================
# 2. 操作系统自动生成文件
# ===================================================

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.fuse_hidden*
.Trash-*


# ===================================================
# 3. 依赖包
# ===================================================

# Node.js (frontend / nestjs)
node_modules/
.npm/

# Maven (Java 后端)
target/

# Gradle (备用)
.gradle/
build/


# ===================================================
# 4. 构建产物
# ===================================================

# Next.js
.next/
out/

# NestJS / TypeScript
dist/
*.tsbuildinfo

# Java 编译产物（不在 target/ 中的残留）
*.class
*.jar
*.war

# 日志
*.log
logs/
*.pid


# ===================================================
# 5. 临时文件和缓存
# ===================================================

# 备份文件
*.backup
*.bak
*.old
*.orig

# 缓存
.cache/
.temp/
.tmp/
temp/
tmp/

# 生成的分析报告
graphify-out/
generated/
outputs/

# Superpowers 工作目录
.superpowers/

# 本地代理/工作区工具产物
.claude/
.worktrees/
.codex-logs/
.playwright-mcp/
artifacts/

# 前端包管理缓存
frontend/.pnpm-store/

# 临时依赖分析输出
seata-dependency-baseline.txt

# Claude Code 本地设置（项目级配置除外）
.claude/settings.local.json

# 测试/验收一次性报告
unit-test/

# 本地运行时上传、日志和进程文件
runtime/

# 旧原型归档，不进入生产交付面
vue-archive/
